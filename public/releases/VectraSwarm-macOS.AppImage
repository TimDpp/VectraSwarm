#!/bin/sh
# AI2-AppImage / macOS Universal Self-Extracting Game Bundle
# Application: Vectra Swarm: Infinite Wave Arena (Pygame + NumPy)
# Supports: Fullscreen (F/F11), Custom Key Rebinding, Volume Mix, High-Contrast Mode
set -e
TMP_APPDIR="$(mktemp -d /tmp/VectraSwarm.AppDir.XXXXXX)"
trap 'rm -rf "$TMP_APPDIR"' EXIT
PAYLOAD_PATH="$TMP_APPDIR/VectraSwarm.pyz"
base64 -d << 'EOF_VECTRA_PAYLOAD' > "$PAYLOAD_PATH"

EOF_VECTRA_PAYLOAD
chmod +x "$PAYLOAD_PATH"
exec python3 "$PAYLOAD_PATH" "$@"
